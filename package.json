{
  "name": "tree-sitter-json",
  "version": "0.24.9",
  "description": "Brokk-maintained Tree-sitter grammar for JSON",
  "type": "module",
  "repository": "https://github.com/BrokkAi/tree-sitter-json",
  "license": "MIT",
  "author": {
    "name": "Max Brunsfeld",
    "email": "maxbrunsfeld@gmail.com"
  },
  "maintainers": [
    "Brokk"
  ],
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "json"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "8.6.0",
    "node-gyp-build": "4.8.4"
  },
  "devDependencies": {
    "eslint": "9.15.0",
    "eslint-config-treesitter": "1.0.2",
    "prebuildify": "6.0.1",
    "tree-sitter-cli": "0.26.13"
  },
  "peerDependencies": {
    "tree-sitter": "0.25.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "bugs": {
    "url": "https://github.com/BrokkAi/tree-sitter-json/issues"
  },
  "homepage": "https://github.com/BrokkAi/tree-sitter-json#readme",
  "scripts": {
    "install": "node-gyp-build",
    "lint": "eslint grammar.js",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
