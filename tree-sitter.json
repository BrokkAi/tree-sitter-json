{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "json",
      "camelcase": "JSON",
      "scope": "source.json",
      "path": ".",
      "file-types": [
        "json"
      ],
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.24.9",
    "license": "MIT",
    "description": "Brokk-maintained Tree-sitter grammar for JSON",
    "authors": [
      {
        "name": "Max Brunsfeld",
        "email": "maxbrunsfeld@gmail.com"
      },
      {
        "name": "Brokk"
      }
    ],
    "links": {
      "repository": "https://github.com/BrokkAi/tree-sitter-json"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
